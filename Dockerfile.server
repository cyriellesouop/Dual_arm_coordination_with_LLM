FROM osrf/ros:humble-desktop

ARG DEBIAN_FRONTEND=noninteractive

# System dependencies: build tools + MoveIt2 stack + vision + audio + utilities
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-rosdep \
    git \
    wget \
    tmux \
    curl \
    sshpass \
    openssh-client \
    ros-humble-vision-msgs \
    ros-humble-moveit \
    ros-humble-moveit-msgs \
    ros-humble-control-msgs \
    ros-humble-controller-manager \
    ros-humble-joint-trajectory-controller \
    ros-humble-joint-state-broadcaster \
    ros-humble-gripper-controllers \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-xacro \
    ros-humble-robot-state-publisher \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-cv-bridge \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-domain-bridge \
    ros-humble-py-binding-tools \
    ros-humble-camera-info-manager \
    libglfw3-dev \
    espeak-ng \
    alsa-utils \
    libasound2-plugins \
    portaudio19-dev \
    pulseaudio-utils \
    ffmpeg \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    pkg-config \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
 && rm -rf /var/lib/apt/lists/*

# opencv-python: PyPI wheel is used because the apt python3-opencv on osrf/ros:humble-desktop
# is built without FFMPEG support. Pin <4.9 and numpy<2 because ros-humble-cv-bridge is a
# pre-compiled C extension built against the NumPy 1.x ABI — it breaks silently with NumPy 2.x.
RUN pip install "opencv-python<4.9" "numpy<2" --quiet

# Clone source packages not available in apt:
#   - ros2_kortex: Kinova driver, bringup, description, MoveIt configs
#   - pymoveit2: Python MoveIt2 interface used by kinova_pick_planner
#   - picknik_controllers: provides picknik_reset_fault_controller + picknik_twist_controller
#     required by kinova_gen3_lite_moveit_config
# NOTE: ros2_robotiq_gripper is intentionally excluded — the Gen3 Lite uses its own
#       built-in gen3_lite_2f gripper, not a Robotiq gripper. robotiq_description is
#       an exec_depend of kortex_bringup but is not required at runtime for Gen3 Lite.
RUN mkdir -p /kortex_ws/src && \
    cd /kortex_ws/src && \
    git clone https://github.com/Kinovarobotics/ros2_kortex.git -b humble && \
    git clone https://github.com/AndrejOrsula/pymoveit2.git && \
    git clone https://github.com/picknikrobotics/picknik_controllers.git -b humble

# Maintained overrides (never edit the vendor files above directly — see
# mujoco_installation_sequence.md Part 2 for the full diff/rationale behind each).
# Add a sim_mujoco branch + kp fallback params to the Gen3 Lite ros2_control xacro
# chain, following the exact same pattern already used there for
# sim_gazebo/sim_ignition/sim_isaac. Copied over the SRC paths (not the installed
# share paths) so the colcon build below installs them the normal way, same as
# every other file in this clone.
COPY docker/kortex_overrides/kinova.urdf.xacro \
     /kortex_ws/src/ros2_kortex/kortex_description/robots/kinova.urdf.xacro
COPY docker/kortex_overrides/kortex_robot.xacro \
     /kortex_ws/src/ros2_kortex/kortex_description/robots/kortex_robot.xacro
COPY docker/kortex_overrides/gen3_lite_macro.xacro \
     /kortex_ws/src/ros2_kortex/kortex_description/arms/gen3_lite/6dof/urdf/gen3_lite_macro.xacro
COPY docker/kortex_overrides/gen3_lite_kortex.ros2_control.xacro \
     /kortex_ws/src/ros2_kortex/kortex_description/arms/gen3_lite/6dof/urdf/kortex.ros2_control.xacro

# Build the full workspace (kortex stack + pymoveit2 + picknik_controllers + robotiq)
# kortex_api uses FetchContent to download the Kinova binary API at build time
RUN cd /kortex_ws && \
    /bin/bash -c "source /opt/ros/humble/setup.bash && \
        apt-get update && \
        rosdep update && \
        rosdep install --from-paths src --ignore-src -r -y \
            --skip-keys 'ament_clang_format ament_clang_tidy gazebo_ros2_control parallel_gripper_controller robotiq_description' && \
        colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && \
        rm -rf /var/lib/apt/lists/*"

# --- MuJoCo physics simulator + mujoco_ros_pkgs (ros2_control bridge) ---
# See mujoco_installation_sequence.md for the full validation history (version
# choice, dependency gaps, domain-collision debugging) behind this block.
ENV MUJOCO_DIR=/root/.mujoco/mujoco-3.3.5
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$MUJOCO_DIR/lib
ENV LIBRARY_PATH=$LIBRARY_PATH:$MUJOCO_DIR/lib

# 3.3.5 specifically, not the latest release: mujoco_ros_pkgs' hybrid-devel
# branch was written against this API surface. Newer MuJoCo (tested: 3.9.0)
# renames/removes several enum constants and struct fields it depends on
# (e.g. mjENBL_ISLAND, mjOption.apirate) and fails to compile against it.
RUN mkdir -p /root/.mujoco && \
    curl -L -o /tmp/mujoco.tar.gz \
        https://github.com/google-deepmind/mujoco/releases/download/3.3.5/mujoco-3.3.5-linux-x86_64.tar.gz && \
    tar -xzf /tmp/mujoco.tar.gz -C /root/.mujoco && \
    rm /tmp/mujoco.tar.gz

# mujoco_ros_pkgs (ubi-agni / Bielefeld University) provides mujoco_ros_control,
# the ros2_control hardware-interface plugin that bridges MuJoCo physics to the
# same controller_manager stack the Kinova arms already use. hybrid-devel
# branch supports ROS1 and ROS2 Humble from one codebase. Cloned into
# kortex_ws/src after that workspace's own build above (not before) so this
# doesn't interact with its rosdep resolution pass.
RUN cd /kortex_ws/src && \
    git clone -b hybrid-devel https://github.com/ubi-agni/mujoco_ros_pkgs.git

RUN cd /kortex_ws && \
    /bin/bash -c "source /opt/ros/humble/setup.bash && \
        source /kortex_ws/install/setup.bash && \
        colcon build --packages-select mujoco_ros mujoco_ros_msgs mujoco_ros_testing_utils mujoco_ros_sensors mujoco_ros_laser mujoco_ros_mocap mujoco_ros_control"

# Python MuJoCo bindings — not required for the ros2_control C++ plugin above,
# but needed for mujoco_ros' own Python binding tests, and useful later for
# scripting scene construction (placing table/object geometry) rather than
# hand-authoring MJCF/XML. numpy<2 re-pinned defensively, same reason as below.
RUN pip install mujoco "numpy<2" --quiet

# Python: vision/detection + llm + audio
# numpy<2 is pinned again here because ultralytics/torch would otherwise upgrade it,
# breaking the ros-humble-cv-bridge binary which was compiled against the NumPy 1.x ABI.
RUN pip install torch ultralytics ollama faster-whisper pyttsx3 sounddevice scipy edge-tts "numpy<2" --quiet

# torch/ultralytics silently pull in a newer setuptools whose _core_metadata.py calls
# packaging.utils.canonicalize_version(..., strip_trailing_zero=False) — a keyword the
# older packaging pinned by ROS Humble's base image doesn't support. This breaks every
# later `colcon build` of any package in this workspace (including the live builds
# run_arm_llm_tmux.sh / run_perception_control_tmux.sh do on every container startup)
# with: TypeError: canonicalize_version() got an unexpected keyword argument
# 'strip_trailing_zero'. Re-pin both to a known-compatible pairing, last, so nothing
# installed above can silently re-break it.
RUN pip install "setuptools<80" "packaging>=23.2" --quiet

# Source ROS, workspace, and set CycloneDDS as RMW (required for MoveIt + kortex)
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /kortex_ws/install/setup.bash" >> /root/.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> /root/.bashrc
