  <!-- Parallel-gripper finger coupling -- the source URDF
       (kinova_dual_arm.urdf.xacro -> gen3_lite_2f_macro.xacro) defines these
       three joints per arm as <mimic joint="right_finger_bottom_joint" .../>
       (left_finger_bottom: multiplier=1.0 offset=0.0; both *_tip_joint:
       multiplier=-0.276 offset=-0.1), but URDF mimic tags are NOT
       automatically converted to MuJoCo equality constraints -- confirmed by
       grepping this file for "equality" before this fix: zero matches. Real
       consequence, not cosmetic: only right_finger_bottom_joint is actually
       commanded (it's the only gripper joint in the ros2_control block, see
       gen3_lite_kortex.ros2_control.xacro); without this coupling,
       left_finger_bottom_joint and both *_tip_joints were genuinely free,
       uncoupled, effectively-passive DOF, driven only by gravity/contact --
       i.e. only ONE of the two fingers was actually closing on the object,
       not a symmetric two-finger pinch. MuJoCo's polycoef="a0 a1 0 0 0"
       implements joint1 = a0 + a1*joint2, matching each mimic's
       offset/multiplier exactly. -->
  <!-- Parallel-gripper finger coupling via MuJoCo equality constraints
       (mimic joint="right_finger_bottom_joint" in the source URDF).
       left_finger_bottom_joint is a PASSIVE follower of
       right_finger_bottom_joint (the only actively-commanded gripper
       joint). A "command both fingers directly" alternative (second
       ros2_control joint + position_controllers/JointGroupPositionController,
       driven in lockstep by mujoco_arm_executor.py) was tried and made
       things WORSE, not better (cup fully launched off the table, vs. the
       ~4cm drift seen with this equality-constraint approach) -- with no
       physical coupling between the two independently-commanded
       controllers, any timing skew between the two publish calls has
       nothing correcting it, unlike the constraint which at least
       continuously pulls them back together despite lagging. Reverted.
       solref/solimp left at MuJoCo's defaults -- stiffening this
       constraint was also tried twice (0.005s: cup drift 182mm; 0.015s:
       130mm), both meaningfully worse than the unmodified default's
       ~48mm. The close-time drift is handled via real velocity-based
       settling in mujoco_arm_executor.py's pick() instead. -->
  <equality>
    <joint joint1="armA_left_finger_bottom_joint" joint2="armA_right_finger_bottom_joint" polycoef="0.0 1.0 0 0 0"/>
    <joint joint1="armA_right_finger_tip_joint" joint2="armA_right_finger_bottom_joint" polycoef="-0.1 -0.276 0 0 0"/>
    <joint joint1="armA_left_finger_tip_joint" joint2="armA_right_finger_bottom_joint" polycoef="-0.1 -0.276 0 0 0"/>
    <joint joint1="armB_left_finger_bottom_joint" joint2="armB_right_finger_bottom_joint" polycoef="0.0 1.0 0 0 0"/>
    <joint joint1="armB_right_finger_tip_joint" joint2="armB_right_finger_bottom_joint" polycoef="-0.1 -0.276 0 0 0"/>
    <joint joint1="armB_left_finger_tip_joint" joint2="armB_right_finger_bottom_joint" polycoef="-0.1 -0.276 0 0 0"/>
  </equality>
</mujoco>
