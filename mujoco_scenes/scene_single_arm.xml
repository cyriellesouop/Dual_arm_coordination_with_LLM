<mujoco model="gen3_lite scene">
  <!--
    Single-arm test scene: floor + lighting + table + two objects + an overview
    camera, wrapped around the converted gen3_lite.xml robot model.

    Table dimensions/position match TABLE_POSITION in kinova_pick_planner.py
    exactly (x=0.325, y=0.00, length=1.80, width=0.75, thickness=0.02, surface
    at z=-0.05), so this scene is consistent with what the rest of the project
    already assumes about the arm's workspace.

    Object positions/sizes are placeholders (a cup-like cylinder, a ball-like
    sphere) for visual completeness — not measured against real object
    dimensions from kinova_pick_planner.py's OBJECT_TYPES.

    Include mechanics: MuJoCo's <include> at the top level of a <mujoco>
    document merges same-named sections (<asset>, <worldbody>) from the
    included file automatically — this is the standard MuJoCo Menagerie
    pattern (robot file + separate scene file), gen3_lite.xml itself needs no
    modification for this to work.

    Must be loaded from the same directory as gen3_lite.xml and the mesh STL
    files (MuJoCo resolves mesh filenames by basename only, relative to the
    loaded XML's directory — see mujoco_installation_sequence.md gotcha 10).
  -->
  <include file="gen3_lite.xml"/>

  <compiler angle="radian"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"
              width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
    <material name="table_mat" rgba="0.55 0.4 0.25 1"/>
    <material name="cup_mat" rgba="0.13 0.59 0.95 1"/>
    <material name="ball_mat" rgba="0.9 0.15 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <light pos="1 -1 2" dir="-0.3 0.3 -1" diffuse="0.4 0.4 0.4"/>

    <!-- Positioned well below the table (surface at z=-0.05) so the table reads as a
         distinct raised surface instead of being hidden inside/behind the floor plane. -->
    <geom name="floor" type="plane" pos="0 0 -0.5" size="3 3 0.05" material="grid"/>

    <!-- Table: center z = TABLE_SURFACE_Z - thickness/2, matching add_table() in
         kinova_pick_planner.py exactly (surface at z=-0.05, thickness=0.02). -->
    <body name="table" pos="0.325 0 -0.06">
      <geom name="table_top" type="box" size="0.9 0.375 0.01" material="table_mat"/>
    </body>

    <!-- Placeholder objects resting on the table surface (z=-0.05) -->
    <body name="cup" pos="0.35 0.15 0.0">
      <freejoint/>
      <geom name="cup_geom" type="cylinder" size="0.035 0.05" material="cup_mat" mass="0.05"/>
    </body>
    <body name="ball" pos="0.40 -0.10 -0.015">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.035" material="ball_mat" mass="0.03"/>
    </body>

    <!-- Overview camera, auto-oriented at the table (no manual angle math needed) -->
    <camera name="overview" pos="1.6 -1.6 1.3" mode="targetbody" target="table"/>
  </worldbody>
</mujoco>
