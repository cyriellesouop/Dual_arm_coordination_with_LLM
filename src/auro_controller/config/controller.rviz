Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Centroids1
        - /Hulls1
        - /ArUco Frame1
        - /ArUco Marker1
        - /Labels1
        - /Controller Objects1
        - /Kinova Arm1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 90
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Centroids
      Namespaces:
        centroids: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead/objects/centroids
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Hulls
      Namespaces:
        hulls: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead/objects/hulls
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Table
      Namespaces:
        table: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead/scene/table
      Value: true

    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.3
      Name: ArUco Frame
      Radius: 0.02
      Reference Frame: table_origin
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ArUco Marker
      Namespaces:
        aruco: true
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead/aruco/marker
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Labels
      Namespaces:
        labels: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead/objects/labels
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Controller Objects
      Namespaces:
        controller_objects: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /controller/object_markers
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Kinova Arm
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MoveIt Planning Scene
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning_scene_world
      Value: true

  Enabled: true
  Global Options:
    Background Color: 20; 20; 30
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.04
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0
    Saved: ~
